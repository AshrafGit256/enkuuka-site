@using Enkuuka.Site.Pages
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f7eeeb" />
    <meta name="description" content="Enkuuka y’Omwaka — the royal Buganda New Year festival at Lubiri Palace, Mengo, Kampala." />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/assets/images/enkuuka-logo.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=DM+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <a class="brand" href="/" aria-label="Enkuuka home"><img class="brand-logo" src="~/assets/images/enkuuka-logo.png" alt="" asp-append-version="true" /><span class="brand-wordmark">Enkuuka <i>y’Omwaka</i></span></a>
        <button class="menu-toggle" type="button" aria-label="Open navigation" aria-expanded="false" aria-controls="site-navigation" data-menu-toggle><span></span><span></span><span></span></button>
        <nav class="site-nav" id="site-navigation" data-menu>
            @foreach (var item in IndexModel.Navigation)
            {
                var active = string.Equals((string?)ViewData["Slug"] ?? "", item.Slug, StringComparison.OrdinalIgnoreCase);
                <a href="@(string.IsNullOrEmpty(item.Slug) ? "/" : $"/{item.Slug}")" class="@(active ? "active" : "")" aria-current="@(active ? "page" : null)">@item.Label</a>
            }
        </nav>
        <div class="header-radio" data-radio-player data-state="ready">
            <div class="header-radio-control">
                <button class="header-radio-open" type="button" data-radio-panel-toggle aria-expanded="false" aria-controls="radio-panel" aria-label="Choose a CBS FM station">
                    <span class="header-radio-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M4 9.5a11 11 0 0 0 0 5M8 7a7 7 0 0 0 0 10m4-12a3 3 0 0 0 0 14m0-9a2 2 0 1 0 0 4 2 2 0 0 0 0-4Zm4-5a7 7 0 0 1 0 14m4-17a11 11 0 0 1 0 20" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/></svg></span>
                    <span class="header-radio-copy"><strong>CBS FM</strong><small data-radio-current>89.2 FM · Emmanduso</small></span>
                    <span class="header-radio-chevron" aria-hidden="true">⌄</span>
                </button>
                <button class="header-radio-toggle" type="button" data-radio-toggle aria-label="Play CBS FM" aria-pressed="false"><span data-radio-toggle-icon aria-hidden="true">▶</span></button>
            </div>
            <section class="header-radio-panel" id="radio-panel" data-radio-panel aria-label="CBS FM radio controls" hidden>
                <div class="header-radio-panel-heading"><div><span class="header-radio-kicker">CBS FM · LIVE RADIO</span><strong>Choose your station</strong></div><span class="header-radio-status" data-radio-status role="status" aria-live="polite">Ready to play</span></div>
                <div class="header-radio-stations" role="group" aria-label="Choose a CBS FM station">
                    <button class="header-radio-station is-selected" type="button" data-radio-station data-stream="https://s5.voscast.com:9905/EMMANDUSO" data-display="89.2 FM · Emmanduso" data-name="Emmanduso" aria-pressed="true"><span class="header-radio-frequency">89.2</span><span class="header-radio-station-copy"><strong>Emmanduso</strong><small>CBS FM</small></span><span class="header-radio-fm">FM</span></button>
                    <button class="header-radio-station" type="button" data-radio-station data-stream="https://s5.voscast.com:9909/EYOBUJJAJJA" data-display="88.8 FM · Ey'obujjajja" data-name="Ey'obujjajja" aria-pressed="false"><span class="header-radio-frequency">88.8</span><span class="header-radio-station-copy"><strong>Ey'obujjajja</strong><small>CBS FM</small></span><span class="header-radio-fm">FM</span></button>
                </div>
                <label class="header-radio-volume"><span>−</span><span>Volume</span><input type="range" min="0" max="1" step="0.05" value="0.8" data-radio-volume aria-label="Radio volume" /><span>+</span></label>
                <a class="header-radio-link" href="https://cbsfm.ug/" target="_blank" rel="noopener noreferrer">Visit CBS FM <span aria-hidden="true">↗</span></a>
            </section>
            <audio data-radio-audio preload="none" src="https://s5.voscast.com:9905/EMMANDUSO"></audio>
        </div>
        <a class="header-cta" href="/invitation">Plan your visit</a>
    </header>

    <main id="main-content" tabindex="-1">@RenderBody()</main>

    <footer class="site-footer">
        <div class="footer-main wrap">
            <div class="footer-brand-block"><a class="brand" href="/"><img class="brand-logo" src="~/assets/images/enkuuka-logo.png" alt="" asp-append-version="true" /><span class="brand-wordmark">Enkuuka <i>y’Omwaka</i></span></a><p>A royal celebration of Buganda’s culture, community and new year.</p></div>
            <div><h2>Explore</h2><a href="/culture">Culture</a><a href="/clans">The clans</a><a href="/masaza">The Masaza</a><a href="/events">Events & entertainment</a></div>
            <div><h2>Visit</h2><a href="/business">Trade fair</a><a href="/accommodation">Accommodation</a><a href="/gallery">Gallery</a><a href="/contact">Contact</a></div>
            <div><h2>Find us</h2><p>Lubiri Palace<br />Mengo, Kampala</p><a href="mailto:info@enkuuka.ug">info@enkuuka.ug</a></div>
        </div>
        <div class="footer-bottom"><div class="wrap"><span>© @DateTime.Now.Year Enkuuka y’Omwaka · Buganda Kingdom</span><span>Organised by CBS FM</span></div></div>
    </footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
